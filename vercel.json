{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/blog", "destination": "/public/blog/index.html" },
    { "source": "/blog/", "destination": "/public/blog/index.html" },
    { "source": "/blog/why-karyaniti-exists", "destination": "/public/blog/why-karyaniti-exists/index.html" },
    { "source": "/:path*", "destination": "/public/:path*" }
  ]
}
