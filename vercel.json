{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": ["data/**"]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/:path*", "destination": "/public/:path*" }
  ]
}
